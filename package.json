{
  "name": "formgen",
  "version": "0.1.0",
  "private": true,
  "description": "Gerador de formulários React acessíveis a partir de uma mini-DSL em português",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "formgen": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"web/**/*.{ts,tsx,css,html}\" \"scripts/**/*.mjs\" \"README.md\"",
    "web:dev": "vite --config web/vite.config.ts",
    "web:check": "tsc -p web/tsconfig.json --noEmit",
    "web:build": "npm run web:check && vite build --config web/vite.config.ts",
    "web:verify": "node scripts/verify-web.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ts-morph": "^28.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@codemirror/view": "^6.43.13",
    "@hookform/resolvers": "^5.9.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.0.0",
    "lucide-react": "^1.48.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
